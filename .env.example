# Provider configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CRITIC_MAX_OUTPUT_TOKENS=768
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_STRUCTURED_THINKING_BUDGET=1024
GEMINI_STRUCTURED_MAX_OUTPUT_TOKENS=8192

# Retrieval configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tutor_documents
RAG_MIN_SCORE=0.35
RAG_EXTERNAL_MIN_SCORE=0.0
DEFAULT_LIBRARY_ID=default
CURRICULUM_MIN_CATEGORIES=3
CURRICULUM_MIN_CHUNKS=4
CURRICULUM_MAX_CONTEXT_CHUNKS=12
CURRICULUM_SEMANTIC_AUDIT_ENABLED=true
EMBEDDING_MODEL_NAME=nomic-embed-text
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
CURRICULUM_LIBRARY_DB_PATH=data/curriculum_library.sqlite3
INGESTION_JOBS_DB_PATH=data/ingestion_jobs.sqlite3
INGESTION_JOBS_DB_PATH=data/ingestion_jobs.sqlite3
EXTERNAL_SEARCH_ENABLED=true
EXTERNAL_SEARCH_RESULTS_PER_QUERY=2
EXTERNAL_SEARCH_CONCURRENCY=3
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_FETCH_MAX_BYTES=2097152
INGESTION_JOB_CONCURRENCY=2
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_STORAGE_DIRECTORY=data/videos_audio
YOUTUBE_STORAGE_DIRECTORY=data/videos_audio/youtube
YOUTUBE_MAXIMUM_DURATION_SECONDS=7200
YOUTUBE_MAXIMUM_FILE_BYTES=524288000

# API configuration
APP_ENV=development
LOG_LEVEL=INFO
